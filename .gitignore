# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node modules (both backend and frontend)
**/node_modules/
**/.next/
**/.turbo/
**/.cache/

# Build output
**/dist/
**/out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env files
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# SQLite database (backend)
**/*.sqlite
**/*.sqlite3
**/database/*.db

# Mac system files
.DS_Store

# VSCode settings
.vscode/

# Local storage (if any)
.next/
coverage/
.cache/
tmp/
*.pid

# Ignore IDE settings
.idea/
*.swp
*.swo
*.bak
*.tmp

# Git conflicts backup
*.orig
